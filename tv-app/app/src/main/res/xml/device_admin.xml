<?xml version="1.0" encoding="utf-8"?>
<!-- Device owner + lock-task need no specific uses-policies; force-lock is the
     one exception. lockNow() is how the panel is genuinely powered down at
     closing time (migration 0078), and DevicePolicyManager refuses it unless the
     admin declares this policy. Without device owner the app never gets it and
     falls back to a black screen at minimum backlight. -->
<device-admin xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-policies>
        <force-lock />
    </uses-policies>
</device-admin>
